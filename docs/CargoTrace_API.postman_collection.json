{
  "info": {
    "name": "CargoTrace REST API",
    "description": "API Collection for CargoTrace Global Shipment Visibility & Tracking Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"newcustomer@cargotrace.test\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/register"
          }
        },
        {
          "name": "Login (Auto-Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@cargotrace.test\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/user"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/logout"
          }
        }
      ]
    },
    {
      "name": "2. Shipments",
      "item": [
        {
          "name": "List All Shipments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/shipments"
          }
        },
        {
          "name": "Create Shipment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipment_number\": \"SHP-2026-8801\",\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 1,\n  \"destination_location_id\": 3,\n  \"cargo_type\": \"Machinery Parts\",\n  \"weight\": 5400,\n  \"volume\": 22.5,\n  \"expected_departure\": \"2026-11-25 08:00:00\",\n  \"expected_arrival\": \"2026-12-05 18:00:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/shipments"
          }
        },
        {
          "name": "Get Shipment Detail + Weather",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/shipments/1"
          }
        },
        {
          "name": "Update Shipment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_status\": \"BOOKED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/shipments/1"
          }
        }
      ]
    },
    {
      "name": "3. Tracking & Exceptions",
      "item": [
        {
          "name": "Get Shipment Tracking Timeline",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/shipments/1/tracking"
          }
        },
        {
          "name": "Add Tracking Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"IN_TRANSIT\",\n  \"event_time\": \"2026-11-24 14:30:00\",\n  \"location_id\": 2,\n  \"description\": \"Transit checkpoint cleared at Singapore hub\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/shipments/1/tracking"
          }
        },
        {
          "name": "Report Shipment Exception",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exception_type\": \"CUSTOMS_HOLD\",\n  \"severity\": \"HIGH\",\n  \"description\": \"Awaiting customs inspection clearance documents\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/shipments/1/exceptions"
          }
        },
        {
          "name": "Resolve Exception",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/exceptions/1"
          }
        }
      ]
    },
    {
      "name": "4. Master Resources",
      "item": [
        {
          "name": "List Carriers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/carriers"
          }
        },
        {
          "name": "List Locations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/locations"
          }
        }
      ]
    }
  ]
}